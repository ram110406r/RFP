# The edge. This is the ONLY thing standing between the internet and the app,
# because the application itself has no real authentication — legacy-api's
# bearer token is just the user's row id and the frontend auto-logs-in as a
# fixed seeded user (see apps/legacy-api/src/lib/auth.ts). That is fine for a
# private demo *only* while this gate is in front of it.
#
# Do not expose the api or web containers' ports on the host. Everything must
# come through here.

{
	# Set ACME_EMAIL in .env.production for Let's Encrypt expiry notices.
	# The default matters: behind Dokploy, Traefik terminates TLS and no email
	# is set, and a bare `email` with an empty value is a Caddyfile parse error
	# that crashloops the container.
	email {$ACME_EMAIL:admin@example.invalid}
}

{$SITE_ADDRESS} {
	encode gzip zstd

	# The password gate. One shared credential for everyone you invite.
	# Generate the hash with:  docker run --rm caddy caddy hash-password --plaintext 'your-password'
	basic_auth {
		{$DEMO_USER} {$DEMO_PASSWORD_HASH}
	}

	# The API is reached same-origin so no public API hostname has to be baked
	# into the browser bundle at build time.
	handle /api/* {
		reverse_proxy api:4000
	}

	# Everything else is the SSR frontend.
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# This is a private pre-release demo — keep it out of search engines.
		X-Robots-Tag "noindex, nofollow"
	}

	log {
		output stdout
		format console
	}
}
