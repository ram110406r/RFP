{
  "name": "rfp-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:apps": "bun scripts/run-with-env.ts turbo run dev --filter=@rfp-os/api --filter=@rfp-os/worker --filter=@rfp-os/web",
    "build": "bun scripts/run-with-env.ts --node-env=production turbo run build",
    "test": "bun scripts/run-with-env.ts --node-env=test --without-database turbo run test",
    "test:db": "bun scripts/run-with-env.ts --node-env=test --require-database turbo run test:db",
    "test:e2e": "bun scripts/run-with-env.ts --node-env=test turbo run test:e2e --filter=@rfp-os/web",
    "lint": "bun scripts/run-with-env.ts turbo run lint",
    "typecheck": "bun scripts/run-with-env.ts turbo run typecheck",
    "format": "prettier --write .",
    "doctor": "bun scripts/doctor.ts",
    "infra:up": "bun scripts/infra-up.ts",
    "infra:down": "bun scripts/infra-down.ts",
    "infra:logs": "bun scripts/infra-logs.ts",
    "infra:reset": "bun scripts/infra-reset.ts",
    "step4:acceptance": "bun scripts/step4-acceptance.ts",
    "db:generate": "bun scripts/run-with-env.ts turbo run db:generate --filter=@rfp-os/db",
    "db:migrate": "bun scripts/run-with-env.ts turbo run db:migrate --filter=@rfp-os/db",
    "db:seed": "bun scripts/run-with-env.ts turbo run db:seed --filter=@rfp-os/db",
    "db:ensure-seed": "bun scripts/run-with-env.ts turbo run db:ensure-seed --filter=@rfp-os/db",
    "db:reset": "bun scripts/run-with-env.ts turbo run db:reset --filter=@rfp-os/db"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.16.5",
    "prettier": "^3.7.3",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.2.0"
  }
}
