{
  "name": "rfp-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "step4:acceptance": "bun scripts/step4-acceptance.ts",
    "db:generate": "turbo run db:generate --filter=@rfp-os/db",
    "db:migrate": "turbo run db:migrate --filter=@rfp-os/db",
    "db:seed": "turbo run db:seed --filter=@rfp-os/db",
    "db:reset": "turbo run db:reset --filter=@rfp-os/db"
  },
  "devDependencies": {
    "prettier": "^3.7.3",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.2.0"
  }
}
