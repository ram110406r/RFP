# Copy to .env.production on the server and fill in. NEVER commit .env.production.
#   cp .env.production.example .env.production

# --- Public address -------------------------------------------------------
# This should match the URL users will actually open, for example:
#   http://localhost:3000
#   https://demo.example.com
# The web service proxies /api requests to the API service internally.
PUBLIC_URL=http://localhost:3000
STORAGE_PUBLIC_ENDPOINT=https://storage.example.com

# --- Web proxy target -----------------------------------------------------
# Used by apps/web for server-side rewrites and SSR when running behind
# Docker or Dokploy.
API_INTERNAL_URL=http://api:4000

# --- Application auth / runtime -------------------------------------------
# Required by the Nest API in production.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Internal queue and storage services used by the bundled compose files.
REDIS_URL=redis://redis:6379
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=rfp-os-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true

# Optional AI provider credentials. Leave blank if Groq is not configured yet.
GROQ_API_KEY=

# --- Firebase public config -----------------------------------------------
# These are public Firebase app settings, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tendyy.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tendyy
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tendyy.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=980605439539
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
NEXT_PUBLIC_ALLOW_GUEST_UI=false

# --- Database -------------------------------------------------------------
# The deployment compose files pass the Postgres credentials as separate
# variables, so the password can contain normal special characters.
# Keep it strong and secret:
#   docker run --rm alpine sh -lc "tr -dc 'A-Za-z0-9!@#$%^&*()_+-=' </dev/urandom | head -c 40; echo"
POSTGRES_USER=rfpos
POSTGRES_PASSWORD=
POSTGRES_DB=rfpos
