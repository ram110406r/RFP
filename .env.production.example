# Copy to .env.production on the server and fill in. NEVER commit .env.production.
#   cp .env.production.example .env.production

# --- Public address -------------------------------------------------------
# This should match the URL users will actually open, for example:
#   http://localhost:3000
#   https://demo.example.com
# The web service proxies /api requests to the API service internally.
PUBLIC_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# The deployment compose files pass the Postgres credentials as separate
# variables, so the password can contain normal special characters.
# Keep it strong and secret:
#   docker run --rm alpine sh -lc "tr -dc 'A-Za-z0-9!@#$%^&*()_+-=' </dev/urandom | head -c 40; echo"
POSTGRES_USER=rfpos
POSTGRES_PASSWORD=
POSTGRES_DB=rfpos
