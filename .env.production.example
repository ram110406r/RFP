# Copy to .env.production on the server and fill in. NEVER commit .env.production.
#   cp .env.production.example .env.production

# --- Public address -------------------------------------------------------
# This should match the URL users will actually open, for example:
#   http://localhost:3000
#   https://demo.example.com
# The web service proxies /api requests to the API service internally.
PUBLIC_URL=http://localhost:3000
# Browser-reachable S3 endpoint used in presigned upload/download URLs.
# With bundled MinIO this is the public app URL; apps/web proxies
# /rfp-os-documents/... to MinIO over the internal Docker network.
STORAGE_PUBLIC_ENDPOINT=http://localhost:3000

# --- Web proxy target -----------------------------------------------------
# Used by apps/web for server-side rewrites and SSR when running behind
# Docker or Dokploy.
API_INTERNAL_URL=http://api:4000

# --- Application auth / runtime -------------------------------------------
APP_ENV=production
NODE_ENV=production
# Required by the Nest API in production. Generate the secret with
# `openssl rand -base64 48`; the API refuses to boot without one.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Google sign-in (Better Auth). Both are required in production.
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=

# Internal queue and storage services used by the bundled compose files.
REDIS_URL=redis://redis:6379
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=rfp-os-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true

# AI provider must not be "mock" in production. GROQ_API_KEY is required
# when AI_PROVIDER=groq; the API refuses to boot without it.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=60000
OPENSEARCH_URL=
UPLOAD_MAX_BYTES=104857600
# Worker refuses to parse stored documents larger than this (default 100 MB).
WORKER_MAX_DOCUMENT_BYTES=104857600
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300

# --- Public web config ----------------------------------------------------
NEXT_PUBLIC_ALLOW_GUEST_UI=false
NEXT_PUBLIC_APP_COMMIT_SHA=unknown
NEXT_PUBLIC_APP_BUILD_TIME=

# Optional build metadata injected by CI/CD.
APP_COMMIT_SHA=unknown
APP_BUILD_TIME=

# --- Database -------------------------------------------------------------
# Required for Dokploy's bundled Postgres service. Compose derives the internal
# app DATABASE_URL from these values:
#   postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# If the password contains URL-reserved characters, URL-encode it or set
# DATABASE_URL explicitly in the advanced override below.
#   docker run --rm alpine sh -lc "tr -dc 'A-Za-z0-9!@#$%^&*()_+-=' </dev/urandom | head -c 40; echo"
POSTGRES_USER=rfpos
POSTGRES_PASSWORD=
POSTGRES_DB=rfpos

# Optional advanced override. Leave empty for the normal single Compose stack.
DATABASE_URL=
