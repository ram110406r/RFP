# Copy to .env.production on the server and fill in. NEVER commit .env.production.
#   cp .env.production.example .env.production

# --- Public address -------------------------------------------------------
# The domain Caddy serves and gets a TLS certificate for. Its DNS A record must
# already point at this server, or certificate issuance will fail.
# For a quick test without a domain, use  :80  (plain HTTP, no TLS).
SITE_ADDRESS=demo.example.com
PUBLIC_URL=https://demo.example.com

# Let's Encrypt sends certificate-expiry warnings here.
ACME_EMAIL=you@example.com

# --- The password gate ----------------------------------------------------
# This is the entire security model for the demo. Treat the password like a
# production credential and share it only with the people you are demoing to.
DEMO_USER=demo

# A bcrypt hash, NOT the plaintext password. Generate it with:
#   docker run --rm caddy caddy hash-password --plaintext 'your-strong-password'
# If the hash contains $ characters, double them ($$) so compose does not
# interpolate them.
DEMO_PASSWORD_HASH=

# --- Database -------------------------------------------------------------
# The password is interpolated into a postgres:// URL, so it must not contain
# /, +, =, @, :, or # — those are URL-structural characters and will produce an
# invalid connection string. Stick to letters and digits:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40; echo
POSTGRES_USER=rfpos
POSTGRES_PASSWORD=
POSTGRES_DB=rfpos
