# Shared local dev environment for the RFP OS monorepo.
# Copy to .env and adjust as needed. Individual apps also read from this file
# (turbo.json declares .env as a global dependency); apps/legacy-web and
# apps/legacy-api keep their own .env.example for now.

NODE_ENV=development

# Postgres (matches docker-compose.yml). Used by packages/db, apps/api, apps/worker.
DATABASE_URL=postgres://rfpos:rfpos_dev_password@localhost:55432/rfpos

# Redis (BullMQ queues). Used by apps/worker, apps/api.
REDIS_URL=redis://localhost:56379

# MinIO / S3-compatible object storage for uploaded documents.
STORAGE_ENDPOINT=http://localhost:59000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=rfp-os-documents
STORAGE_ACCESS_KEY_ID=rfpos
STORAGE_SECRET_ACCESS_KEY=rfpos_dev_password

# OpenSearch (hybrid search).
OPENSEARCH_URL=http://localhost:45200

# Ports. 4100 (not 4000) so apps/api can run alongside apps/legacy-api
# (which defaults to 4000, see apps/legacy-api/.env.example) during migration.
API_PORT=4100
WEB_PORT=3000

# Public API origin used by apps/web in production builds.
# For same-origin deployments, this can match the web URL.
API_URL=http://localhost:4100
NEXT_PUBLIC_API_URL=http://localhost:4100

# CORS origins the API accepts requests from.
CORS_ORIGIN=http://localhost:3000
NO_PROXY=localhost,127.0.0.1,::1,api.groq.com
no_proxy=localhost,127.0.0.1,::1,api.groq.com

# Better Auth (see apps/api auth module once implemented).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4100
FIREBASE_PROJECT_ID=tendyy

# AI provider credentials — consumed only by packages/ai's provider
# implementations, never referenced directly from business logic.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=60000
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tendyy.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tendyy
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tendyy.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=980605439539
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

LOG_LEVEL=info
