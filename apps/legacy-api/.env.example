# Postgres connection string used by both the API server and drizzle-kit.
# Local dev default matches docker-compose.yml at the repo root.
DATABASE_URL=postgres://rfpos:rfpos_dev_password@localhost:55432/rfpos

# Port the Elysia API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (the frontend dev server).
CORS_ORIGIN=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084

# Dev-only auth boundary (see src/lib/auth.ts). Not a production auth system —
# see README for how to swap in a real provider (e.g. better-auth) later.
DEV_AUTH_ENABLED=true

# Object storage for uploaded RFP documents (S3/MinIO-compatible). Optional in
# dev — when unset, document upload persists metadata only (see src/modules/documents.ts).
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# AI provider config, only needed if answer generation is wired to a real model.
AI_PROVIDER_API_KEY=
