# Copy to .env.local or .env.production for the Next.js web app.

# Internal API origin used by the Next.js server for rewrites and SSR.
# In Docker / Dokploy this should point at the API container, for example
# http://api:4000.
API_INTERNAL_URL=http://localhost:4100

# Optional legacy overrides if you want the browser to talk to a direct API
# origin instead of using same-origin requests.
API_URL=http://localhost:4100
NEXT_PUBLIC_API_URL=http://localhost:4100

# Optional local override when the build output directory must be changed.
NEXT_DIST_DIR=.next

# Development and Playwright only. Example: 127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
