# Copy to .env.local or .env.production for the Next.js web app.

# Public API origin used by Next.js rewrites and server-side fetches.
# In production this must point at the real API origin.
API_URL=http://localhost:4100
NEXT_PUBLIC_API_URL=http://localhost:4100

# Optional local override when the build output directory must be changed.
NEXT_DIST_DIR=.next
