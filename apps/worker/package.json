{
  "name": "@rfp-os/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun ../../scripts/run-with-env.ts bun --watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "bun ../../scripts/run-with-env.ts bun src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src --path-ignore-patterns \"**/document-processor.test.ts\" --path-ignore-patterns \"**/extraction.repository.test.ts\" --path-ignore-patterns \"**/requirement-extraction.processor.test.ts\" --path-ignore-patterns \"**/tender-ingestion.repository.test.ts\"",
    "test:db": "bun test src/documents/document-processor.test.ts src/documents/extraction.repository.test.ts src/documents/requirement-extraction.processor.test.ts src/tender-discovery/tender-ingestion.repository.test.ts"
  },
  "dependencies": {
    "@rfp-os/ai": "workspace:*",
    "@rfp-os/db": "workspace:*",
    "@rfp-os/document-processing": "workspace:*",
    "@rfp-os/jobs": "workspace:*",
    "@rfp-os/observability": "workspace:*",
    "@rfp-os/storage": "workspace:*",
    "@rfp-os/types": "workspace:*",
    "@rfp-os/validation": "workspace:*",
    "bullmq": "^5.34.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.44.7",
    "fflate": "^0.8.2",
    "ioredis": "^5.4.1",
    "pdfjs-dist": "6.2.108",
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@rfp-os/config": "workspace:*",
    "@types/bun": "latest",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
